# pi-loop environment variables
# Copy this file to `.env` and fill in the values you want to enable.
# Leaving any var unset (or commenting it out) disables that feature.

# ─────────────────────────────────────────────────────────────────────────────
# Sentry crash analytics (opt-in)
# ─────────────────────────────────────────────────────────────────────────────
# Apply for Sentry for Open Source at https://sentry.io/for/open-source/
# Once approved, copy the project DSN into SENTRY_DSN below to enable
# anonymous crash and log reporting from pi-loop.
#
# When SENTRY_DSN is unset (the default), all telemetry is a no-op:
#  - initSentry() returns false
#  - captureException / addBreadcrumb / logInfo / logWarn / etc. are no-ops
#  - All tool execution wraps still run but call no Sentry APIs
#
# To get a DSN for personal/development use, sign up at https://sentry.io/
# and create a Node.js project. The DSN is the public client identifier
# (safe to share — it only grants *send* permission, not read).
# SENTRY_DSN=https://publickey@o1234567.ingest.us.sentry.io/1234567

# Environment tag for ingested events (e.g. "production", "staging").
# Defaults to "development" when unset.
# SENTRY_ENVIRONMENT=development

# Overrides the auto-detected release tag. Defaults to
# `@bramburn/pi-loop@<package-version>`.
# SENTRY_RELEASE=@bramburn/pi-loop@1.1.0

# Sample rate for performance transactions (0.0–1.0). Lower values reduce
# quota usage. The OSS sponsorship tier has generous limits, but 0.1 is a
# safe default for normal loop/monitor workloads.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable Sentry's own debug logging to stderr.
# SENTRY_DEBUG=false

# Pipe the extension's internal debug() output into Sentry logs.
# Set to "false" to keep console-only logging (saves quota).
# SENTRY_CAPTURE_LOGS=true

# ─────────────────────────────────────────────────────────────────────────────
# pi-loop scope and persistence
# ─────────────────────────────────────────────────────────────────────────────
# Where loops and native fallback tasks are stored. Default: "project".
# PI_LOOP_SCOPE=project

# Per-session tasks override.
# PI_TASKS_SCOPE=session

# Override the default loops store path.
# PI_LOOP=/abs/path/to/loops.json

# ─────────────────────────────────────────────────────────────────────────────
# Debug & development
# ─────────────────────────────────────────────────────────────────────────────
# Enable debug output to stderr (independent of Sentry).
# PI_LOOP_DEBUG=1
